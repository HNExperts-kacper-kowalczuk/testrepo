CREATE TABLE user_profile (
    id INTEGER NOT NULL PRIMARY KEY,
    pregnancy_caution INTEGER NOT NULL DEFAULT 0,
    fragrance_free INTEGER NOT NULL DEFAULT 0,
    locale_preference TEXT NOT NULL DEFAULT 'system',
    pinned_locale TEXT,
    eu_allergens INTEGER NOT NULL DEFAULT 0,
    children_caution INTEGER NOT NULL DEFAULT 0,
    alcohol_leave_on INTEGER NOT NULL DEFAULT 0,
    essential_oil_cluster INTEGER NOT NULL DEFAULT 0,
    ads_removed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE user_avoid_ingredient (
    ingredient_id TEXT NOT NULL PRIMARY KEY
);

CREATE TABLE scan_history (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    scanned_at TEXT NOT NULL,
    gtin TEXT,
    product_id TEXT,
    inci_raw TEXT NOT NULL,
    rating TEXT NOT NULL,
    source TEXT NOT NULL,
    name TEXT,
    brand TEXT,
    usage TEXT NOT NULL DEFAULT 'UNKNOWN',
    category TEXT
);

CREATE TABLE user_shelf (
    shelf_key TEXT NOT NULL PRIMARY KEY,
    product_id TEXT,
    gtin TEXT,
    name TEXT,
    brand TEXT,
    inci_raw TEXT NOT NULL,
    rating TEXT NOT NULL,
    usage TEXT NOT NULL,
    category TEXT,
    saved_at TEXT NOT NULL
);

CREATE TABLE report_queue (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    created_at TEXT NOT NULL,
    kind TEXT NOT NULL,
    gtin TEXT,
    payload_json TEXT NOT NULL,
    flushed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE cached_online_product (
    gtin TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    brand TEXT,
    inci_raw TEXT NOT NULL,
    usage TEXT NOT NULL,
    source TEXT NOT NULL,
    cached_at TEXT NOT NULL
);

CREATE TABLE user_legal (
    id INTEGER NOT NULL PRIMARY KEY,
    disclaimer_accepted INTEGER NOT NULL DEFAULT 0,
    accepted_at TEXT
);

selectProfile:
SELECT *
FROM user_profile
WHERE id = 1;

upsertProfile:
INSERT OR REPLACE INTO user_profile(
    id,
    pregnancy_caution,
    fragrance_free,
    locale_preference,
    pinned_locale,
    eu_allergens,
    children_caution,
    alcohol_leave_on,
    essential_oil_cluster,
    ads_removed
)
VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAvoidIds:
SELECT ingredient_id
FROM user_avoid_ingredient;

insertAvoid:
INSERT OR IGNORE INTO user_avoid_ingredient(ingredient_id)
VALUES (?);

deleteAvoid:
DELETE FROM user_avoid_ingredient
WHERE ingredient_id = ?;

clearAvoid:
DELETE FROM user_avoid_ingredient;

insertHistory:
INSERT INTO scan_history(scanned_at, gtin, product_id, inci_raw, rating, source, name, brand, usage, category)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clearHistory:
DELETE FROM scan_history;

selectHistory:
SELECT *
FROM scan_history
ORDER BY scanned_at DESC
LIMIT 100;

selectLegal:
SELECT *
FROM user_legal
WHERE id = 1;

upsertLegal:
INSERT OR REPLACE INTO user_legal(id, disclaimer_accepted, accepted_at)
VALUES (1, ?, ?);

selectCachedProduct:
SELECT *
FROM cached_online_product
WHERE gtin = ?;

upsertCachedProduct:
INSERT OR REPLACE INTO cached_online_product(gtin, name, brand, inci_raw, usage, source, cached_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectOpenReport:
SELECT *
FROM report_queue
WHERE gtin = ? AND kind = ? AND flushed = 0
LIMIT 1;

insertReport:
INSERT INTO report_queue(created_at, kind, gtin, payload_json, flushed)
VALUES (?, ?, ?, ?, 0);

updateReportPayload:
UPDATE report_queue
SET payload_json = ?
WHERE id = ?;

countOpenReports:
SELECT COUNT(*)
FROM report_queue
WHERE flushed = 0;

selectOpenReports:
SELECT *
FROM report_queue
WHERE flushed = 0
ORDER BY created_at DESC
LIMIT 200;

selectShelf:
SELECT *
FROM user_shelf
ORDER BY saved_at DESC;

selectShelfByKey:
SELECT *
FROM user_shelf
WHERE shelf_key = ?;

upsertShelf:
INSERT OR REPLACE INTO user_shelf(
    shelf_key,
    product_id,
    gtin,
    name,
    brand,
    inci_raw,
    rating,
    usage,
    category,
    saved_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteShelf:
DELETE FROM user_shelf
WHERE shelf_key = ?;
